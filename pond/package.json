{
  "name": "insert-coin-pond",
  "private": true,
  "version": "0.1.0",
  "description": "The pond — ducky.davidyang.work, the web half of the BY-002 Insert Coin card",
  "type": "module",
  "scripts": {
    "dev": "vercel dev",
    "deploy": "vercel --prod",
    "db:apply": "tsx tools/db-apply.ts",
    "db:verify": "tsx tools/db-verify.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "cards:import": "tsx tools/import-cards.ts",
    "cards:check": "tsx tools/check-card.ts",
    "build:client": "node tools/build-client.mjs",
    "stickers": "python3 tools/gen-stickers.py",
    "verify": "npm run typecheck && npm run build:client && npm test",
    "ship": "npm run verify && vercel deploy --prod --yes"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4"
  }
}
