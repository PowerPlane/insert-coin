/*
 * FIRMWARE_SECRET — copy to secrets.h and fill in. NEVER COMMIT secrets.h.
 *
 * The key the card signs its claims with. Every card has the same one, so
 * the firmware stays identical on every board and there is still no
 * per-card data to keep track of.
 *
 * ══ WHAT IT PROTECTS, AND WHAT IT DOES NOT ══
 * It stops someone forging a claim they never held the card for, and it
 * stops a claim URL seen over a shoulder being replayed. It does NOT stop
 * someone extracting it from a card they physically possess — set the
 * ATtiny lock bits and accept that a determined attacker with a programmer
 * wins. For a hundred cards given to friends that is proportionate; if
 * these are ever sold, this needs a per-card key written at flash time.
 *
 * ══ THE SERVER NEEDS THE SAME VALUE ══
 * Set CARD_SECRET in Vercel to the hex of these exact sixteen bytes. If
 * they differ, every claim fails verification — quietly, because a failed
 * claim looks the same as a card nobody has claimed.
 *
 *   openssl rand -hex 16
 *
 * The test vectors in shared/firmware/card-identity/card-identity.json use
 * a DIFFERENT, published key (00 01 … 0f). Nothing derived from the real
 * secret belongs in this repository.
 */

#pragma once

#include <stdint.h>

/* Replace every byte. These zeros are not a default, they are a placeholder
 * — a card flashed with them signs claims anyone can forge. */
static const uint8_t FIRMWARE_SECRET[16] = {
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
};
