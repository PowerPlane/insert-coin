# macOS
.DS_Store
._*

# KiCad autosaves & backups
*-backups/
backups/
_autosave-*.kicad_pcb
_autosave-*.kicad_sch
*.kicad_pcb-bak
*.kicad_sch-bak
*.bak
fp-info-cache

# KiCad "project is open" lock files (machine-specific, never useful in git)
~*.lck
*.lck

# KiCad local-history extension (per-project snapshot store)
.history/

# Fabrication toolkit / placement helper noise
place_footprints.log

# PlatformIO
.pio/
.pioenvs/
.piolibdeps/
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch
.clang_complete
.gcc-flags.json

# Build artifacts (release .hex/.elf are committed explicitly when shipped)
build/
*.o
*.lst
*.map

# Python venvs (if any tooling needs one later)
.venv/
__pycache__/
*.pyc

# Editor
*.swp
*.swo

# Claude Code worktrees (per-session, never useful in git)
.claude/

# Pond web app
pond/node_modules/
pond/.vercel/
pond/.env*.local
pond/*.db
pond/*.db-journal

# pond/public/ used to be ignored, back when Wrangler built the client into
# it. On Vercel it is the OUTPUT DIRECTORY — the CDN serves it verbatim and
# nothing generates it — so ignoring it would deploy a site with no
# stylesheet and no script, and the only symptom would be a blank page.

# The firmware's claim-signing key. secrets.h.example is the template;
# the real one never enters the repository, and the server's CARD_SECRET
# must be set to the same sixteen bytes.
**/production-pond/src/secrets.h
variants/business-card-v1/cards.csv

# esbuild's bundle analysis. Useful locally, not worth shipping.
pond/public/.build.meta
